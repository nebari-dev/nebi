# Darb Environment Variables
# Copy this file to .env and update with your values

# Authentication Secrets
# Encrypts stored registry credentials (at least 32 characters).
export NEBI_AUTH_JWT_SECRET="dev-secret-that-is-at-least-32-chars-long"

# Authentication
# config.yaml runs development without authentication (auth.type: none).
# To sign in through an OpenID Connect provider instead, for example the
# Keycloak from docker-compose.yml:
# export NEBI_AUTH_TYPE="oidc"
# export NEBI_AUTH_OIDC_ISSUER_URL="https://keycloak.example.com/realms/nebi"
# export NEBI_AUTH_OIDC_CLIENT_ID="nebi"
# export NEBI_AUTH_OIDC_ADMIN_GROUPS="nebi-admin"

# Database (optional)
# export NEBI_DATABASE_DRIVER="sqlite"
# export NEBI_DATABASE_DSN="./nebi.db"

# Server (optional)
# export NEBI_SERVER_PORT="8460"
# export NEBI_SERVER_MODE="development"

# Docker Compose deployment: see docker/compose.env.example
