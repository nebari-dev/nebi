# Settings for docker-compose.yml. Copy to .env.compose in the repository
# root and fill in, then run:
#   docker compose --env-file .env.compose up -d
# Generate secrets with: openssl rand -hex 32

NEBI_DOMAIN=nebi.example.com
KEYCLOAK_DOMAIN=auth.example.com
# Let's Encrypt account email (unused with docker/local.override.yml, but
# still required by docker-compose.yml).
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
NEBI_DB_PASSWORD=

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Encrypts stored registry credentials; at least 32 characters.
NEBI_JWT_SECRET=

# Run a published nebi-server image instead of building this checkout.
# NEBI_IMAGE=quay.io/nebari/nebi@sha256:...

# For a laptop with docker/local.override.yml:
# NEBI_DOMAIN=nebi.nebi.localhost
# KEYCLOAK_DOMAIN=auth.nebi.localhost
