# Copy to .env.oidc in the repo root and fill in. Generate secrets with:
#   openssl rand -hex 32
NEBI_DOMAIN=nebi.example.com
KEYCLOAK_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
NEBI_DB_PASSWORD=

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

NEBI_OIDC_CLIENT_SECRET=
NEBI_JWT_SECRET=

# Run a published nebi-server image instead of building from this checkout.
# NEBI_IMAGE=quay.io/nebari/nebi@sha256:...
