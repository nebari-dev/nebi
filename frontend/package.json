{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @nebi/client --",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build --workspaces --if-present",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:write": "biome format --write",
    "ci": "biome ci",
    "preview": "npm run preview --workspace @nebi/client --",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:watch": "vitest",
    "dev:client": "npm run dev --workspace @nebi/client --",
    "dev:server": "npm run dev --workspace @nebi/server --",
    "build:embed": "npm run build && node scripts/copy-dist.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.16",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
